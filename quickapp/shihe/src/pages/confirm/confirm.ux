<template><div class="page"><scroll class="content {{narrowLayout ? 'narrow-content' : ''}}" scroll-y="true"><text class="title">确认餐食</text><text class="subtitle">{{mealLabel}} · 保存前可调整</text><div class="card" if="{{items.length}}"><div class="item" for="(index, item) in items"><div class="item-top {{narrowLayout ? 'narrow-row' : ''}}"><text class="name">{{item.name}}</text><text class="kcal">{{item.kcal}} kcal</text></div><text class="amount">{{item.basisAmount}}{{item.basisUnit}} · 每100{{item.basisUnit}} {{item.energyKcalPer100}} kcal</text><div class="controls {{narrowLayout ? 'narrow-row' : ''}}"><input class="circle" type="button" value="−" onclick="minus(index)"/><input class="circle" type="button" value="＋" onclick="plus(index)"/><input class="remove" type="button" value="删除" onclick="remove(index)"/></div></div></div><div class="empty-card" if="{{!items.length}}"><text class="warn">草稿为空，不能保存</text></div><div class="total {{narrowLayout ? 'narrow-row' : ''}}"><text class="label">合计 · 估算</text><text class="big">{{totalKcal}}</text><text class="unit">kcal</text></div><div class="favorite {{narrowLayout ? 'narrow-row' : ''}}"><input class="checkbox" type="checkbox" checked="{{favorite}}" onchange="toggleFavorite"/><text class="favorite-label">收藏为套餐（最多 8 个）</text></div><text class="warn" if="{{message}}">{{message}}</text><input class="primary" type="button" disabled="{{saving || !items.length}}" value="{{saving ? '正在保存并回验…' : '确认保存'}}" onclick="save"/><input class="secondary" type="button" value="返回修改" onclick="back"/><text class="disclaimer">热量按食品唯一每百单位值重算，仅供生活管理参考</text><div class="bottom-space"></div></scroll></div></template>
<script>
import router from '@system.router'
import { FOODS, calculateFoodKcal } from '../../data/foods'
import { validateState } from '../../common/state'
import { loadState, saveState } from '../../common/state-store'
import { detectNarrowLayout } from '../../common/display-profile'
import { adjustItem, totalItemsKcal, makeMealRecord, upsertMeal, updateRecent, addFavorite, syncMealPromptState, parseMealDraft } from '../../common/meal-domain'
const validateStoredState=state=>validateState(state,FOODS)
const LABELS={breakfast:'早餐',lunch:'午餐',dinner:'晚餐',snack:'加餐'}
export default {protected:{draftJson:''},private:{narrowLayout:true,draft:null,items:[],mealLabel:'',totalKcal:0,favorite:false,saving:false,message:''},onInit(){detectNarrowLayout(value=>{this.narrowLayout=value});this.draft=parseMealDraft(this.draftJson,FOODS,calculateFoodKcal);if(this.draft){this.items=this.draft.items;this.mealLabel=LABELS[this.draft.mealType];this.recount()}},recount(){this.totalKcal=totalItemsKcal(this.items);if(this.draft)this.draft.items=this.items},minus(index){this.items=adjustItem(FOODS,calculateFoodKcal,this.items,index,-1);this.recount()},plus(index){this.items=adjustItem(FOODS,calculateFoodKcal,this.items,index,1);this.recount()},remove(index){this.items=this.items.filter((item,i)=>i!==index);this.recount()},toggleFavorite(event){this.favorite=event.checked===true},save(){if(this.saving||!this.draft||!this.items.length)return;const now=Date.now();this.draft.items=this.items;const record=makeMealRecord(FOODS,calculateFoodKcal,this.draft,now);if(!record){this.message='草稿无效，无法保存';return}this.saving=true;loadState(validateStoredState,loaded=>{if(loaded.status!=='ok'){this.saving=false;this.message='本地记录读取失败，未保存';return}const state=Object.assign({},loaded.state);state.meals=upsertMeal(state.meals,record);state.mealPromptState=syncMealPromptState(state.mealPromptState,state.meals,record.localDate);state.recentFoodIds=updateRecent(state.recentFoodIds,record.items);if(this.favorite)state.favoriteMeals=addFavorite(state.favoriteMeals,record,now);state.lastMaintenanceAt=now;saveState(validateStoredState,state,result=>{this.saving=false;if(result.status==='ok')router.replace({uri:'/pages/home'});else this.message='保存或读取回验失败，请重试'})})},back(){router.back()} }
</script>
<style>
.page{width:100%;height:100%;background-color:#090a09;flex-direction:column}.content{width:100%;height:100%;flex-direction:column;padding:30px 26px 24px}.title{color:#f4f1e8;font-size:32px;font-weight:bold;text-align:center}.subtitle,.amount,.disclaimer{color:#858681;font-size:16px;text-align:center;margin:6px 0 14px}.card,.empty-card{width:100%;flex-direction:column;background-color:#1c1d1c;border-radius:24px;padding:18px;margin-bottom:14px}.item{width:100%;flex-direction:column;border-bottom-width:1px;border-color:#343534;padding:11px 0}.item-top{width:100%;justify-content:space-between}.name{color:#f4f1e8;font-size:20px;font-weight:bold}.kcal{color:#b8b7b1;font-size:18px}.amount{text-align:left;margin:5px 0}.controls{width:100%;justify-content:flex-end}.circle,.remove{width:56px;height:46px;border-radius:23px;background-color:#292a29;color:#e5e1d8;font-size:22px;margin-left:8px}.remove{width:76px;background-color:#322826;color:#d9aaa2;font-size:16px}.total{width:100%;align-items:flex-end;justify-content:center;margin:8px 0 16px}.label{color:#949590;font-size:17px}.big{color:#f4f1e8;font-size:58px;font-weight:bold;margin:0 9px}.unit{color:#858681;font-size:17px}.favorite{width:100%;align-items:center;justify-content:center;margin-bottom:14px}.checkbox{width:44px;height:44px}.favorite-label{color:#c7c4bc;font-size:18px;margin-left:8px}.warn{color:#c7a382;font-size:17px;text-align:center;margin-bottom:10px}.primary,.secondary{width:100%;height:58px;border-radius:29px;background-color:#f28a32;color:#17120e;font-size:21px;font-weight:bold;margin-bottom:11px}.secondary{height:48px;background-color:#222322;color:#d5d2ca;font-size:17px;font-weight:normal}.disclaimer{line-height:24px}.bottom-space{height:36px}
.narrow-content{width:92%;padding-left:0;padding-right:0;margin-left:4%}.narrow-row{width:100%}
</style>
