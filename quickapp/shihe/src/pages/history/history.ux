<template><div class="page"><scroll class="content" scroll-y="true">
<text class="title">最近 7 天</text><text class="status" if="{{message}}">{{message}}</text>
<text class="subtitle">用一周窗口观察记录节奏，不作营养诊断</text>
<div class="week-card"><text class="week-title">本周记录概览</text><div class="week-metrics"><div class="week-metric"><text class="week-value">{{recordedDays}}/7</text><text class="week-label">有记录天数</text></div><div class="week-metric"><text class="week-value">{{averageIntakeKcal}}</text><text class="week-label">记录日均 kcal</text></div><div class="week-metric"><text class="week-value blue">{{foodVarietyCount}}/25</text><text class="week-label">食品种类</text></div></div><text class="week-note">种类数按已记录食品去重估算，记录越完整越有参考价值。</text></div>
<div class="day {{day.isToday ? 'today' : ''}}" for="(index, day) in days"><div class="day-head"><text class="date">{{day.localDate}}</text><text class="today-label" if="{{day.isToday}}">今天</text></div><div class="metrics"><div class="metric"><text class="value orange">{{day.intakeKcal}}</text><text class="label">餐食摄入</text></div><div class="metric"><text class="value green">{{day.exerciseKcal}}</text><text class="label">手动补录</text></div><div class="metric"><text class="value">{{day.netKcal}}</text><text class="label">估算净摄入</text></div></div></div>
<text class="disclaimer">食物热量和手动补录消耗均为估算；无餐食记录的日期不参与记录日平均值。</text><input class="back" type="button" value="返回" onclick="back"/><div class="bottom-space"></div>
</scroll></div></template>
<script>
import router from '@system.router'
import { FOODS } from '../../data/foods'
import { validateState } from '../../common/state'
import { loadState } from '../../common/state-store'
import { localDateOf, sevenDayEnergyTrend, sevenDayDietSummary } from '../../common/energy-domain'
const validateStoredState=state=>validateState(state,FOODS)
export default {data:{days:[],recordedDays:0,averageIntakeKcal:0,foodVarietyCount:0,message:''},onShow(){loadState(validateStoredState,result=>{if(result.status!=='ok'||!result.state.profile){this.days=[];this.recordedDays=0;this.averageIntakeKcal=0;this.foodVarietyCount=0;this.message=result.status==='corrupt'?'本地数据损坏，未作覆盖':'无法读取本机记录';return}const today=localDateOf(Date.now());this.days=sevenDayEnergyTrend(result.state.meals,result.state.exercises,today,result.state.profile.dailyTargetKcal).map(day=>Object.assign({},day,{isToday:day.localDate===today}));const summary=sevenDayDietSummary(result.state.meals,today);this.recordedDays=summary.recordedDays;this.averageIntakeKcal=summary.averageIntakeKcal;this.foodVarietyCount=summary.foodVarietyCount;this.message=''})},back(){router.back()}}
</script>
<style>
.page{width:100%;height:100%;background-color:#090a09;flex-direction:column}.content{width:100%;height:100%;flex-direction:column;padding:28px 26px 24px}.title{color:#f4f1e8;font-size:32px;font-weight:bold;text-align:center}.subtitle,.disclaimer{color:#858681;font-size:15px;text-align:center;margin:6px 0 14px;line-height:22px}.status{color:#c7a382;font-size:17px;text-align:center;margin-top:8px}.week-card,.day{width:100%;flex-direction:column;background-color:#1c1d1c;border-radius:22px;padding:15px 17px;margin-bottom:11px}.week-title{color:#f4f1e8;font-size:19px;font-weight:bold}.week-metrics,.metrics{width:100%;justify-content:space-between;align-items:center;margin-top:10px}.week-metric,.metric{width:33%;flex-direction:column;align-items:center}.week-value{color:#e5e1d8;font-size:22px;font-weight:bold}.week-label,.label{color:#858681;font-size:13px;text-align:center}.week-note{color:#777873;font-size:13px;line-height:19px;text-align:center;margin-top:10px}.blue{color:#8fa8bf}.today{background-color:#24211e}.day-head{width:100%;justify-content:space-between;align-items:center}.date{color:#e5e1d8;font-size:19px;font-weight:bold}.today-label{color:#aaa8a1;font-size:16px}.value{color:#d5d2ca;font-size:24px;font-weight:bold}.orange{color:#d5d2ca}.green{color:#d5d2ca}.back{width:100%;height:48px;border-radius:24px;background-color:#222322;color:#c7c4bc;font-size:17px}.bottom-space{height:34px}
</style>
