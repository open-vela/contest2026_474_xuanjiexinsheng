<template>
  <div class="page">
    <scroll class="content" scroll-y="true">
      <text class="title">最近 7 天饮食记录</text>
      <text class="status" if="{{message}}">{{message}}</text>
      <text class="subtitle">用最近七天观察自己的记录节奏</text>

      <div class="week-card">
        <text class="week-title">近 7 天概览</text>
        <div class="week-metrics">
          <div class="week-metric"><text class="week-value">{{recordedDays}}/7</text><text class="week-label">有记录天数</text></div>
          <div class="week-metric"><text class="week-value">{{averageIntakeKcal}}</text><text class="week-label">有记录日平均 kcal</text></div>
        </div>
      </div>

      <div class="day {{day.isToday ? 'today' : ''}}" for="(index, day) in days">
        <div class="day-head"><text class="date">{{day.localDate}}</text><text class="today-label" if="{{day.isToday}}">今天</text></div>
        <div class="day-summary"><text class="meal-count">已记录 {{day.mealCount}} 餐</text><text class="value">{{day.intakeKcal}} kcal</text></div>
      </div>

      <text class="disclaimer">仅根据已记录餐食统计，记录不完整时不代表实际全天摄入。</text>
      <input class="back" type="button" value="返回" onclick="back"/>
      <div class="bottom-space"></div>
    </scroll>
  </div>
</template>

<script>
import router from '@system.router'
import { FOODS } from '../../data/foods'
import { validateState } from '../../common/state'
import { loadState } from '../../common/state-store'
import { localDateOf, sevenDayDietTrend, sevenDayDietSummary } from '../../common/energy-domain'

const validateStoredState = state => validateState(state, FOODS)

export default {
  data: { days: [], recordedDays: 0, averageIntakeKcal: 0, message: '' },
  onShow() {
    loadState(validateStoredState, result => {
      if (result.status !== 'ok' || !result.state.profile) {
        this.days = []; this.recordedDays = 0; this.averageIntakeKcal = 0
        this.message = result.status === 'corrupt' ? '本地数据损坏，未作覆盖' : '无法读取本机记录'
        return
      }
      const today = localDateOf(Date.now())
      this.days = sevenDayDietTrend(result.state.meals, today).map(day => Object.assign({}, day, { isToday: day.localDate === today }))
      const summary = sevenDayDietSummary(result.state.meals, today)
      this.recordedDays = summary.recordedDays; this.averageIntakeKcal = summary.averageIntakeKcal; this.message = ''
    })
  },
  back() { router.back() }
}
</script>

<style>
.page{width:100%;height:100%;background-color:#090a09;flex-direction:column}.content{width:100%;height:100%;flex-direction:column;padding:28px 26px 24px}.title{color:#f4f1e8;font-size:30px;font-weight:bold;text-align:center}.subtitle,.disclaimer{color:#858681;font-size:15px;text-align:center;margin:6px 0 14px;line-height:22px}.status{color:#c7a382;font-size:17px;text-align:center;margin-top:8px}.week-card,.day{width:100%;flex-direction:column;background-color:#1c1d1c;border-radius:22px;padding:15px 17px;margin-bottom:11px}.week-title{color:#f4f1e8;font-size:19px;font-weight:bold}.week-metrics{width:100%;justify-content:space-between;align-items:center;margin-top:12px}.week-metric{width:49%;flex-direction:column;align-items:center}.week-value{color:#e5e1d8;font-size:24px;font-weight:bold}.week-label{color:#858681;font-size:13px;text-align:center}.today{background-color:#24211e}.day-head,.day-summary{width:100%;justify-content:space-between;align-items:center}.day-summary{margin-top:10px}.date{color:#e5e1d8;font-size:19px;font-weight:bold}.today-label{color:#aaa8a1;font-size:16px}.meal-count{color:#949590;font-size:16px}.value{color:#d5d2ca;font-size:22px;font-weight:bold}.back{width:100%;height:48px;border-radius:24px;background-color:#222322;color:#c7c4bc;font-size:17px}.bottom-space{height:34px}
</style>
