<template><div class="page"><scroll class="content {{narrowLayout ? 'narrow-content' : ''}}" scroll-y="true">
<text class="title">记下这一餐</text>
<div class="meal-types" if="{{!narrowLayout}}"><input class="chip {{mealType === 'breakfast' ? 'active' : ''}}" type="button" value="早餐" onclick="chooseType('breakfast')"/><input class="chip {{mealType === 'lunch' ? 'active' : ''}}" type="button" value="午餐" onclick="chooseType('lunch')"/><input class="chip {{mealType === 'dinner' ? 'active' : ''}}" type="button" value="晚餐" onclick="chooseType('dinner')"/><input class="chip {{mealType === 'snack' ? 'active' : ''}}" type="button" value="加餐" onclick="chooseType('snack')"/></div>
<div class="narrow-meal-types" if="{{narrowLayout}}"><div class="narrow-meal-row"><input class="narrow-chip {{mealType === 'breakfast' ? 'active' : ''}}" type="button" value="早餐" onclick="chooseType('breakfast')"/><input class="narrow-chip {{mealType === 'lunch' ? 'active' : ''}}" type="button" value="午餐" onclick="chooseType('lunch')"/></div><div class="narrow-meal-row"><input class="narrow-chip {{mealType === 'dinner' ? 'active' : ''}}" type="button" value="晚餐" onclick="chooseType('dinner')"/><input class="narrow-chip {{mealType === 'snack' ? 'active' : ''}}" type="button" value="加餐" onclick="chooseType('snack')"/></div></div>
<div class="mode-switch"><input class="mode {{entryMode === 'transcript' ? 'mode-active' : ''}}" type="button" value="一句话记餐" onclick="chooseMode('transcript')"/><input class="mode {{entryMode === 'quick' ? 'mode-active' : ''}}" type="button" value="快捷选择" onclick="chooseMode('quick')"/></div>

<div class="mode-content" if="{{entryMode === 'transcript'}}">
  <div class="card transcript">
    <text class="notice">选择一句模拟器转写文本。初赛不是录音或语音识别。</text>
    <picker class="transcript-picker" if="{{!parsed}}" type="text" range="{{transcriptExamples}}" selected="{{transcriptExampleIndex}}" onchange="chooseTranscript"></picker>
    <text class="selected-transcript" if="{{!parsed}}">将识别：{{transcript}}</text>
    <input class="parse" if="{{!parsed}}" type="button" value="识别这顿饭" onclick="parseText"/>
    <div class="parsed-result" if="{{parsed}}">
      <text class="source-text">原文：{{transcript}}</text>
      <input class="example edit-text" type="button" value="修改这句话" onclick="editText"/>
      <div class="assumption" for="assumptions"><text class="assumption-title">{{$item.name}} · 约 {{$item.totalKcal}} kcal</text><text class="assumption-copy">{{$item.componentLabel}}</text><text class="assumption-note">{{$item.note}}</text></div>
      <text class="label">识别结果</text>
      <text class="empty" if="{{!recognized.length}}">没有识别到可记录食品</text>
      <text class="result parsed-line" for="recognized">{{$item.name}} · {{$item.basisAmount}}{{$item.basisUnit}} · {{$item.kcal}} kcal</text>
      <input class="ignore" if="{{!unknown.length && recognized.length}}" type="button" value="去确认并调整" onclick="goParsed"/>
      <text class="label unknown" if="{{unknown.length}}">需要处理的内容</text>
      <text class="warn parsed-line" for="unknown">“{{$item.text}}” · {{$item.reasonLabel}}</text>
      <input class="ignore" if="{{unknown.length && recognized.length}}" type="button" value="忽略未识别项并确认" onclick="ignoreAndContinue"/>
      <text class="warn" if="{{unknown.length}}">也可修改文本后重新识别；未识别内容不会被静默保存。</text>
    </div>
  </div>
</div>

<div class="mode-content" if="{{entryMode === 'quick'}}">
  <div class="draft"><div class="draft-head"><text class="card-title">当前已选 {{items.length}} 项</text><input class="clear" if="{{items.length}}" type="button" value="清空" onclick="clearDraft"/></div><text class="empty" if="{{!items.length}}">从下方加入食品，误选可随时移除</text><div class="draft-item" for="(index, item) in items"><div class="draft-main"><text class="food-name">{{item.name}}</text><text class="draft-kcal">{{item.basisAmount}}{{item.basisUnit}} · {{item.kcal}} kcal</text></div><div class="draft-actions"><input class="draft-button" type="button" value="−" onclick="minusDraft(index)"/><input class="draft-button" type="button" value="＋" onclick="plusDraft(index)"/><input class="remove" type="button" value="移除" onclick="removeDraft(index)"/></div></div><text class="draft-total" if="{{items.length}}">合计约 {{draftTotalKcal}} kcal</text></div>
  <input class="primary" type="button" disabled="{{!items.length}}" value="进入确认（{{items.length}} 项）" onclick="confirmCatalog"/>
  <div class="card"><text class="card-title">最近食品</text><text class="empty" if="{{!recentFoods.length}}">保存第一餐后，这里会出现最近选择</text><div class="food-row" for="recentFoods" onclick="addRecent($item)"><text class="food-name">{{$item.name}}</text><text class="add">＋ {{$item.defaultServing.label}}</text></div></div>
  <div class="card"><text class="card-title">收藏套餐</text><text class="empty" if="{{!favorites.length}}">可在确认页收藏整餐，下次直接复用</text><div class="food-row" for="favorites" onclick="useFavorite($item)"><text class="food-name">{{$item.name}}</text><text class="add">直接去确认 ›</text></div></div>
  <div class="card"><text class="card-title">食品目录</text><picker class="picker" type="text" range="{{categories}}" selected="{{categoryIndex}}" onchange="changeCategory"></picker><text class="catalog-count">{{catalogCountText}}</text><div class="food-row" for="catalog" onclick="addCatalog($item)"><text class="food-name">{{$item.name}}</text><text class="add">＋ {{$item.defaultServing.label}}</text></div></div>
</div>
<div class="bottom-space"></div>
</scroll></div></template>

<script>
import router from '@system.router'
import { FOODS, calculateFoodKcal } from '../../data/foods'
import { MEAL_TEMPLATES, MEAL_TEMPLATE_NOTE } from '../../data/meal-templates'
import { validateState } from '../../common/state'
import { loadState } from '../../common/state-store'
import { parseMealText } from '../../common/meal-text-parser'
import { inferMealType, addFoodToItems, adjustItem, itemFromFood, foodById, serializeMealDraft, totalItemsKcal } from '../../common/meal-domain'
import { detectNarrowLayout } from '../../common/display-profile'

const validateStoredState = state => validateState(state, FOODS)
const lookupFood = foodId => foodById(FOODS, foodId)
const CATEGORY_KEYS = ['', '主食', '常见菜肴', '蛋白质', '蔬菜', '水果', '饮品', '零食']
const CATEGORY_LABELS = ['全部（60）', '主食（12）', '常见菜肴（10）', '蛋白质（10）', '蔬菜（8）', '水果（8）', '饮品（7）', '零食（5）']
const REASON_LABELS = { negation:'包含否定表达，请改写', unknown_food:'本地词典暂未收录', unsupported_unit:'暂不支持这个单位', invalid_quantity_or_missing_unit:'份量或单位不完整', invalid_quantity:'份量无效', too_many_segments:'一次最多识别 12 项', input_too_long:'输入超过 80 个字', unsupported_modifier:'套餐含个性化要求，请在展开后手动调整', invalid_template:'套餐模板暂不可用' }

export default {
  data:{narrowLayout:true,state:null,mealType:'snack',entryMode:'transcript',categories:CATEGORY_LABELS,categoryIndex:0,catalog:FOODS,catalogCountText:'当前显示 60 / 共 60 项',recentFoods:[],favorites:[],items:[],draftSource:'catalog',draftTotalKcal:0,transcriptExamples:['台湾卤肉饭','番茄炒蛋盖饭','一碗米饭、一份番茄炒蛋、一杯无糖豆浆','牛肉面'],transcriptExampleIndex:0,transcript:'台湾卤肉饭',parsed:false,recognized:[],unknown:[],assumptions:[]},
  onInit(){detectNarrowLayout(value=>{this.narrowLayout=value});loadState(validateStoredState,result=>{if(result.status!=='ok')return;this.state=result.state;this.mealType=inferMealType(result.state.profile,Date.now());this.recentFoods=result.state.recentFoodIds.map(lookupFood).filter(Boolean);this.favorites=result.state.favoriteMeals})},
  chooseType(type){this.mealType=type},
  chooseMode(mode){this.entryMode=mode},
  changeCategory(event){this.categoryIndex=event.newValue;const key=CATEGORY_KEYS[this.categoryIndex];this.catalog=key?FOODS.filter(food=>food.category===key):FOODS;this.catalogCountText='当前显示 '+this.catalog.length+' / 共 '+FOODS.length+' 项'},
  recountDraft(){this.draftTotalKcal=totalItemsKcal(this.items)},
  addCatalog(food){this.items=addFoodToItems(calculateFoodKcal,this.items,food);this.draftSource='catalog';this.recountDraft()},
  addRecent(food){this.items=addFoodToItems(calculateFoodKcal,this.items,food);this.draftSource='recent';this.recountDraft()},
  minusDraft(index){this.items=adjustItem(FOODS,calculateFoodKcal,this.items,index,-1);this.recountDraft()},
  plusDraft(index){this.items=adjustItem(FOODS,calculateFoodKcal,this.items,index,1);this.recountDraft()},
  removeDraft(index){this.items=this.items.filter((item,i)=>i!==index);this.recountDraft()},
  clearDraft(){this.items=[];this.recountDraft()},
  openConfirm(draft){router.push({uri:'/pages/confirm',params:{draftJson:serializeMealDraft(draft)}})},
  useFavorite(favorite){const items=favorite.items.map(item=>itemFromFood(calculateFoodKcal,lookupFood(item.foodId),item.amount));this.openConfirm({mealType:this.mealType,source:'favorite',items})},
  chooseTranscript(event){this.transcriptExampleIndex=event.newValue;this.transcript=this.transcriptExamples[event.newValue]},
  parseText(){const output=parseMealText(this.transcript,FOODS,calculateFoodKcal,MEAL_TEMPLATES);this.parsed=true;this.recognized=output.recognizedItems;this.unknown=output.unknownSegments.map(item=>Object.assign({},item,{reasonLabel:REASON_LABELS[item.reason]||'需要手动确认'}));this.assumptions=output.assumptions.map(item=>({name:item.name,totalKcal:item.totalKcal,componentLabel:item.components.map(component=>component.name+' '+component.basisAmount+component.basisUnit).join('、'),note:MEAL_TEMPLATE_NOTE}))},
  editText(){this.parsed=false;this.recognized=[];this.unknown=[];this.assumptions=[]},
  goParsed(){if(!this.recognized.length)return;let items=[];this.recognized.forEach(item=>{items=addFoodToItems(calculateFoodKcal,items,lookupFood(item.foodId),item.basisAmount)});this.openConfirm({mealType:this.mealType,source:'transcript-demo',items})},
  ignoreAndContinue(){if(this.recognized.length&&this.unknown.length)this.goParsed()},
  confirmCatalog(){if(!this.items.length)return;this.openConfirm({mealType:this.mealType,source:this.draftSource,items:this.items})}
}
</script>

<style>
.page{width:100%;height:100%;background-color:#090a09;flex-direction:column}.content{width:100%;height:100%;flex-direction:column;padding:24px 26px 22px}.title{color:#f4f1e8;font-size:32px;font-weight:bold;text-align:center;margin-bottom:12px}.mode-content{width:100%;flex-direction:column}.card,.draft{width:100%;flex-direction:column;background-color:#1c1d1c;border-radius:24px;padding:16px;margin-bottom:12px}.card-title,.label{color:#f4f1e8;font-size:20px;font-weight:bold;margin-bottom:9px}.meal-types{width:100%;flex-direction:row;justify-content:space-between;margin-bottom:11px}.chip{width:23%;height:42px;border-radius:21px;background-color:#292a29;color:#aaa9a3;font-size:16px}.active{background-color:#35322f;color:#f4f1e8}.mode-switch{width:100%;height:46px;flex-direction:row;border-radius:23px;background-color:#1c1d1c;padding:3px;margin-bottom:11px}.mode{width:50%;height:40px;border-radius:20px;background-color:#1c1d1c;color:#858681;font-size:16px}.mode-active{background-color:#35322f;color:#f4f1e8}.empty,.notice{color:#858681;font-size:15px;line-height:22px}.notice{margin-bottom:8px}.food-row{width:100%;min-height:52px;flex-direction:row;align-items:center;justify-content:space-between;border-top-width:1px;border-color:#343534}.food-name,.result{color:#e5e1d8;font-size:17px}.add{color:#aaa9a3;font-size:15px}.picker,.transcript-picker{width:100%;height:52px;color:#e5e1d8;font-size:18px}.transcript-picker{border-radius:18px;background-color:#292a29}.selected-transcript{color:#c7c4bc;font-size:15px;line-height:22px;margin-top:6px}.catalog-count{color:#777873;font-size:14px;margin-bottom:7px}.example,.parse,.ignore{width:100%;height:46px;border-radius:23px;background-color:#292a29;color:#d5d2ca;font-size:16px;margin-top:8px}.parse,.ignore{background-color:#f28a32;color:#17120e}.parsed-result{width:100%;flex-direction:column}.source-text{width:100%;color:#e5e1d8;font-size:17px;line-height:25px;margin-bottom:9px}.edit-text{margin-top:0;margin-bottom:12px}.parsed-line{width:100%;line-height:25px;margin-bottom:6px}.unknown{margin-top:12px}.warn{color:#c7a382;font-size:16px;line-height:24px}.assumption{width:100%;flex-direction:column;background-color:#242321;border-radius:18px;padding:13px;margin-bottom:13px}.assumption-title{color:#f0d0ae;font-size:18px;font-weight:bold}.assumption-copy{color:#d5d2ca;font-size:15px;line-height:22px;margin-top:5px}.assumption-note{color:#8f8e88;font-size:13px;line-height:20px;margin-top:5px}.draft{background-color:#202120}.draft-head,.draft-main,.draft-actions{width:100%;flex-direction:row;align-items:center}.draft-head,.draft-main{justify-content:space-between}.draft-item{width:100%;flex-direction:column;border-top-width:1px;border-color:#343534;padding:10px 0}.draft-main{align-items:flex-start}.draft-kcal{color:#858681;font-size:14px;text-align:right}.draft-actions{justify-content:flex-end;margin-top:7px}.draft-button,.remove,.clear{height:42px;border-radius:21px;background-color:#2b2c2b;color:#e5e1d8;font-size:18px;margin-left:7px}.draft-button{width:50px}.remove{width:70px;color:#d9aaa2;background-color:#322826;font-size:15px}.clear{width:68px;color:#aaa9a3;font-size:15px}.draft-total{color:#c7c4bc;font-size:15px;text-align:right;margin-top:8px}.primary{width:100%;height:58px;border-radius:29px;background-color:#f28a32;color:#17120e;font-size:21px;font-weight:bold;margin-bottom:12px}.bottom-space{height:32px}
.narrow-content{width:92%;padding-left:0;padding-right:0;margin-left:4%}.narrow-meal-types{width:100%;flex-direction:column;margin-bottom:7px}.narrow-meal-row{width:100%;flex-direction:row;justify-content:space-between;margin-bottom:6px}.narrow-chip{width:48%;height:40px;border-radius:20px;background-color:#292a29;color:#aaa9a3;font-size:16px}.narrow-chip.active{background-color:#35322f;color:#f4f1e8}
</style>
