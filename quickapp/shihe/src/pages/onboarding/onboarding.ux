<template>
  <div class="page">
    <scroll class="content {{narrowLayout ? 'narrow-content' : ''}}" scroll-y="true">
      <text class="title">首次设置</text>
      <text class="subtitle">设置饮食参考线与三餐时段</text>

      <div class="warning" if="{{storageStatus === 'corrupt'}}">
        <text class="warning-text">检测到损坏的本地数据，只有确认重建后才会覆盖。</text>
        <div class="check-row"><input class="checkbox" type="checkbox" checked="{{rebuildConfirmed}}" onchange="confirmRebuild" /><text class="check-label">确认重建本地数据</text></div>
      </div>
      <div class="warning" if="{{storageStatus === 'unavailable'}}">
        <text class="warning-text">本地存储暂不可用，当前设置无法可靠保存，请稍后重试。</text>
      </div>

      <div class="card">
        <text class="label">每日饮食参考线</text>
        <text class="number orange">{{targetKcal}} kcal</text>
        <text class="target-help">2000 kcal 是成人食品营养标签采用的一日能量参考值，用于对照记录，不是个人饮食处方，也不要求必须吃满。</text>
        <text class="target-note">{{targetReferenceText}}</text>
        <text class="target-note">实际需要会随年龄、性别、体型和活动量变化。</text>
        <slider min="1200" max="4000" step="100" value="{{targetKcal}}" onchange="changeTarget"></slider>
        <text class="target-warning" if="{{lowTarget}}">参考线低于 1500 kcal，如用于控制体重，建议先咨询专业人员。</text>
        <text class="target-notice" if="{{targetAdjustmentNotice}}">{{targetAdjustmentNotice}}</text>
      </div>

      <div class="card">
        <text class="card-title">三个默认餐段</text>
        <div class="meal-row"><text class="meal-name">早餐</text><div class="time-range"><div class="time-line"><text class="time-label">开始</text><picker class="time-picker" type="time" selected="{{windows.breakfast.start}}" onchange="breakfastStart"></picker></div><div class="time-line"><text class="time-label">结束</text><picker class="time-picker" type="time" selected="{{windows.breakfast.end}}" onchange="breakfastEnd"></picker></div></div></div>
        <div class="meal-row"><text class="meal-name">午餐</text><div class="time-range"><div class="time-line"><text class="time-label">开始</text><picker class="time-picker" type="time" selected="{{windows.lunch.start}}" onchange="lunchStart"></picker></div><div class="time-line"><text class="time-label">结束</text><picker class="time-picker" type="time" selected="{{windows.lunch.end}}" onchange="lunchEnd"></picker></div></div></div>
        <div class="meal-row"><text class="meal-name">晚餐</text><div class="time-range"><div class="time-line"><text class="time-label">开始</text><picker class="time-picker" type="time" selected="{{windows.dinner.start}}" onchange="dinnerStart"></picker></div><div class="time-line"><text class="time-label">结束</text><picker class="time-picker" type="time" selected="{{windows.dinner.end}}" onchange="dinnerEnd"></picker></div></div></div>
      </div>

      <div class="card">
        <text class="notice">食衡中的食物热量和建议均为估算，仅供生活管理参考，不构成医疗、诊断、治疗或专业营养建议。如有疾病、过敏、孕期或饮食障碍等情况，请咨询合格专业人士。</text>
        <div class="check-row"><input class="checkbox" type="checkbox" checked="{{accepted}}" onchange="changeAccepted" /><text class="check-label">我已阅读并接受</text></div>
      </div>

      <text class="error" if="{{errorMessage}}">{{errorMessage}}</text>
      <input class="primary" type="button" disabled="{{saving}}" value="{{saving ? '正在保存…' : '保存并进入食衡'}}" onclick="save" />
      <div class="bottom-space"></div>
    </scroll>
  </div>
</template>

<script>
import router from '@system.router'
import { FOODS } from '../../data/foods'
import { defaultMealWindows, createOnboardedState, validateState, editableDailyTarget, isLowDailyTarget, dailyTargetReferenceText } from '../../common/state'
import { loadState, saveState } from '../../common/state-store'
import { detectNarrowLayout } from '../../common/display-profile'

const validateStoredState = state => validateState(state, FOODS)

function timeFromEvent(event) {
  const hour = Number(event.hour)
  const minute = Number(event.minute)
  return (hour < 10 ? '0' : '') + hour + ':' + (minute < 10 ? '0' : '') + minute
}

export default {
  data: {
    narrowLayout: true,
    storageStatus: 'empty',
    targetKcal: 2000,
    targetReferenceText: dailyTargetReferenceText(2000),
    lowTarget: false,
    targetAdjustmentNotice: '',
    windows: defaultMealWindows(),
    accepted: false,
    rebuildConfirmed: false,
    saving: false,
    errorMessage: '',
    existingState: null
  },
  onInit() {
    detectNarrowLayout(value => { this.narrowLayout = value })
    loadState(validateStoredState, result => {
      if (result.status === 'ok' && result.state.profile) {
        const profile = result.state.profile
        this.existingState = result.state
        this.targetKcal = editableDailyTarget(profile.dailyTargetKcal)
        this.targetReferenceText = dailyTargetReferenceText(this.targetKcal)
        this.lowTarget = isLowDailyTarget(this.targetKcal)
        this.targetAdjustmentNotice = this.targetKcal === profile.dailyTargetKcal ? '' : '原目标超出当前编辑范围；只有保存后才会更新。'
        this.windows = profile.mealWindows
        this.accepted = true
        this.storageStatus = 'ok'
      } else if (result.status !== 'empty') {
        this.storageStatus = result.status
      }
    })
  },
  changeTarget(event) { this.targetKcal = event.progress; this.targetReferenceText = dailyTargetReferenceText(event.progress); this.lowTarget = isLowDailyTarget(event.progress); this.targetAdjustmentNotice = '' },
  changeAccepted(event) { this.accepted = event.checked === true },
  confirmRebuild(event) { this.rebuildConfirmed = event.checked === true },
  setTime(meal, edge, event) {
    const next = defaultMealWindows()
    next.breakfast = { start: this.windows.breakfast.start, end: this.windows.breakfast.end }
    next.lunch = { start: this.windows.lunch.start, end: this.windows.lunch.end }
    next.dinner = { start: this.windows.dinner.start, end: this.windows.dinner.end }
    next[meal][edge] = timeFromEvent(event)
    this.windows = next
  },
  breakfastStart(event) { this.setTime('breakfast', 'start', event) },
  breakfastEnd(event) { this.setTime('breakfast', 'end', event) },
  lunchStart(event) { this.setTime('lunch', 'start', event) },
  lunchEnd(event) { this.setTime('lunch', 'end', event) },
  dinnerStart(event) { this.setTime('dinner', 'start', event) },
  dinnerEnd(event) { this.setTime('dinner', 'end', event) },
  save() {
    if (this.saving) return
    this.errorMessage = ''
    if (!this.accepted) { this.errorMessage = '请阅读并接受免责声明'; return }
    if (this.storageStatus === 'corrupt' && !this.rebuildConfirmed) { this.errorMessage = '请先明确确认重建损坏数据'; return }
    if (this.storageStatus === 'unavailable') { this.errorMessage = '本地存储不可用，暂时无法保存'; return }
    const fresh = createOnboardedState(this.targetKcal, this.windows, Date.now())
    if (!fresh) { this.errorMessage = '请检查参考线和餐段起止时间'; return }
    const state = this.existingState || fresh
    state.profile = fresh.profile
    state.lastMaintenanceAt = fresh.lastMaintenanceAt
    this.saving = true
    saveState(validateStoredState, state, result => {
      this.saving = false
      if (result.status === 'ok') router.replace({ uri: '/pages/home' })
      else this.errorMessage = '保存或读取回验失败，输入仍已保留，请重试'
    })
  }
}
</script>

<style>
.page { width: 100%; height: 100%; background-color: #090a09; flex-direction: column; }
.content { width: 100%; height: 100%; flex-direction: column; padding: 30px 26px 24px 26px; }
.title { color: #f4f1e8; font-size: 34px; font-weight: bold; text-align: center; }
.subtitle { color: #858681; font-size: 18px; text-align: center; margin: 6px 0 18px 0; }
.card, .warning { width: 100%; flex-direction: column; background-color: #1c1d1c; border-radius: 24px; padding: 18px; margin-bottom: 14px; }
.warning { background-color: #29221e; }
.warning-text, .error { color: #c7a382; font-size: 17px; line-height: 25px; }
.label, .card-title { color: #d5d2ca; font-size: 19px; }
.card-title { font-weight: bold; margin-bottom: 11px; }
.number { color: #f4f1e8; font-size: 36px; font-weight: bold; margin: 7px 0; }
.orange { color: #f4f1e8; }
.meal-row { width: 100%; flex-direction: column; align-items: flex-start; color: #e5e1d8; font-size: 18px; margin: 7px 0; }
.meal-name { color: #e5e1d8; font-size: 18px; margin-bottom: 2px; }
.time-range { width: 100%; flex-direction: column; }
.time-line { width: 100%; align-items: center; margin-bottom: 3px; }
.time-label { width: 22%; color: #858681; font-size: 15px; }
.time-picker { width: 31%; height: 50px; color: #e5e1d8; font-size: 17px; }
.check-row { width: 100%; min-height: 44px; align-items: center; margin-top: 9px; }
.checkbox { width: 44px; height: 44px; }
.check-label { color: #c7c4bc; font-size: 18px; margin-left: 9px; }
.notice { color: #aaa8a1; font-size: 16px; line-height: 24px; margin-bottom: 11px; }
.target-help { color: #c7c4bc; font-size: 16px; line-height: 23px; margin-bottom: 5px; }
.target-note { color: #858681; font-size: 14px; line-height: 21px; margin-bottom: 8px; }
.target-warning { color: #d3a06f; font-size: 15px; line-height: 22px; margin-top: 8px; }
.target-notice { color: #8fa4b8; font-size: 14px; line-height: 21px; margin-top: 7px; }
.error { text-align: center; margin: 4px 0 11px 0; }
.primary { width: 100%; height: 58px; border-radius: 29px; background-color: #f28a32; color: #17120e; font-size: 21px; font-weight: bold; }
.bottom-space { height: 34px; }
.narrow-content{width:92%;padding-left:0;padding-right:0;margin-left:4%}
</style>
